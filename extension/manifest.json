{
  "manifest_version": 3,
  "name": "Nexus Calculator & Converter Hub",
  "short_name": "Nexus Calc",
  "version": "1.0.0",
  "description": "Smart scientific calculator, multi-unit converter, developer utilities, and instant search across 100+ tools on nexuscalculator.net.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Nexus Calculator & Converter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "omnibox": {
    "keyword": "nx"
  },
  "permissions": [
    "storage"
  ],
  "homepage_url": "https://www.nexuscalculator.net"
}
